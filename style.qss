/* ── Main window ── */
#mainFrame {
    background-color: #1E1E2E;
    border-radius: 12px;
}

#titleBar {
    background-color: #181825;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#titleLabel {
    color: #CDD6F4;
    font-size: 14px;
    font-weight: bold;
    padding-left: 4px;
}

#miniBtn, #closeBtn {
    background-color: transparent;
    color: #A6ADC8;
    border: none;
    font-size: 16px;
    font-weight: bold;
}
#miniBtn:hover, #closeBtn:hover {
    color: #F38BA8;
    background-color: rgba(243, 139, 168, 0.15);
    border-radius: 6px;
}

/* ── Input bar ── */
#inputBar {
    background-color: #1E1E2E;
}

#inputField {
    background-color: #313244;
    color: #CDD6F4;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

#highBtn {
    background-color: #F38BA8;
    color: #1E1E2E;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
}
#highBtn:hover {
    background-color: #FAB387;
}

/* ── Task list ── */
#taskList {
    background-color: #1E1E2E;
    border: none;
    outline: none;
    padding: 4px;
}
#taskList::item {
    background-color: transparent;
    border: none;
    padding: 0;
    margin: 0;
}
#taskList::item:selected {
    background-color: #313244;
}
QScrollBar:vertical {
    background-color: #1E1E2E;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background-color: #45475A;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ── Task item ── */
#taskItem {
    background-color: #181825;
    border-radius: 8px;
    margin: 3px 2px;
}

#taskCheck {
    border: 2px solid #6C7086;
    border-radius: 4px;
    background: transparent;
    color: transparent;
    font-size: 12px;
}
#taskCheck:checked {
    border: 2px solid #A6E3A1;
    background-color: #A6E3A1;
    color: #1E1E2E;
}

#taskText {
    color: #CDD6F4;
    font-size: 13px;
}
#taskText[done="true"] {
    color: #6C7086;
    text-decoration: line-through;
}

#delBtn {
    background: transparent;
    color: #6C7086;
    border: none;
    font-size: 14px;
}
#delBtn:hover {
    color: #F38BA8;
}

#priorityDot {
    color: #F38BA8;
    font-weight: bold;
    font-size: 14px;
}

/* ── Footer ── */
#footerBar {
    background-color: #1E1E2E;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

#statsLabel {
    color: #6C7086;
    font-size: 12px;
}

/* ── Mini bar ── */
#miniBar {
    background-color: #1E1E2E;
    border-radius: 10px;
    border: 1px solid #45475A;
}

#miniCount {
    color: #CDD6F4;
    font-size: 13px;
}

/* ── Archive window ── */
#archiveFrame {
    background-color: #1E1E2E;
    border-radius: 12px;
}

#archiveTitleBar {
    background-color: #181825;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

#archiveTitleLabel {
    color: #CDD6F4;
    font-size: 14px;
    font-weight: bold;
    padding-left: 4px;
}

#archiveCloseBtn, #archiveCopyBtn {
    background-color: transparent;
    color: #A6ADC8;
    border: none;
    font-size: 16px;
    font-weight: bold;
}
#archiveCloseBtn:hover, #archiveCopyBtn:hover {
    color: #F38BA8;
    background-color: rgba(243, 139, 168, 0.15);
    border-radius: 6px;
}

#archiveScroll {
    background-color: #1E1E2E;
    border: none;
}

#archiveContent {
    background-color: #1E1E2E;
}

#archiveEmpty {
    color: #6C7086;
    font-size: 13px;
    padding: 20px;
}
#archiveDateLabel {
    color: #89B4FA;
    font-size: 12px;
    font-weight: bold;
    padding: 8px 8px 2px 8px;
}

#archiveItem {
    background-color: #181825;
    border-radius: 6px;
    margin: 2px 4px;
}
#archiveCheck {
    color: #6C7086;
    font-size: 13px;
    min-width: 18px;
    text-align: center;
}
#archiveCheck[done="true"] {
    color: #A6E3A1;
}

#archiveText {
    color: #CDD6F4;
    font-size: 13px;
}
#archiveText[done="true"] {
    color: #6C7086;
    text-decoration: line-through;
}

#archivePriorityDot {
    color: #F38BA8;
    font-weight: bold;
    font-size: 14px;
}

QMenu {
    background-color: #1E1E2E;
    border: 1px solid #45475A;
    border-radius: 6px;
    padding: 4px 0;
}
QMenu::item {
    color: #CDD6F4;
    padding: 6px 20px;
    font-size: 13px;
}
QMenu::item:selected {
    background-color: #313244;
}
